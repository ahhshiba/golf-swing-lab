# golf-swing-lab training venv: top-level pins (human-edited). The full resolved set is requirements.lock.
# Rebuild: /usr/bin/python3.12 -m venv ~/.local/share/golf-swing-lab-venv && ~/.local/share/golf-swing-lab-venv/bin/python -m pip install -r training/requirements.lock
# torch must come from the CUDA 13 index (RTX 5060 Ti / Blackwell needs cu130 wheels); everything else from PyPI.
--index-url https://download.pytorch.org/whl/cu130
--extra-index-url https://pypi.org/simple
torch==2.14.0
mediapipe==1.2.2
